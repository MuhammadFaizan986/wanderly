# Copy to .env and fill in. Never commit .env.

# --- App ---
ENVIRONMENT=local            # local | test | staging | production
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false               # pretty console logs locally; JSON in production
CORS_ORIGINS=http://localhost:3100

# --- Infrastructure (host ports from docker-compose.yml) ---
DATABASE_URL=postgresql+asyncpg://wanderly:wanderly@localhost:5442/wanderly
REDIS_URL=redis://localhost:6390/0

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production-please-32-bytes-min
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
COOKIE_SECURE=false          # must be true in production (HTTPS)
COOKIE_SAMESITE=lax          # use "none" when frontend and API are on different sites

# --- LLM ---
LLM_PROVIDER=anthropic       # anthropic | openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# --- External APIs ---
DUFFEL_API_TOKEN=            # test-mode token starts with duffel_test_
UNSPLASH_ACCESS_KEY=
RESEND_API_KEY=
EMAIL_FROM=Wanderly <onboarding@resend.dev>
