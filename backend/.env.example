# Copy to .env and fill in. Never commit .env.

# --- App ---
# local | test | staging | production
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO
# pretty console logs locally; JSON in production
LOG_JSON=false
CORS_ORIGINS=http://localhost:3100

# --- Infrastructure (host ports from docker-compose.yml) ---
DATABASE_URL=postgresql+asyncpg://wanderly:wanderly@localhost:5442/wanderly
REDIS_URL=redis://localhost:6390/0

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production-please-32-bytes-min
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
# must be true in production (HTTPS)
COOKIE_SECURE=false
# use "none" when frontend and API are on different sites
COOKIE_SAMESITE=lax

# --- LLM ---
# anthropic | openai
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# --- External APIs ---
# test-mode token starts with duffel_test_
DUFFEL_API_TOKEN=
UNSPLASH_ACCESS_KEY=
RESEND_API_KEY=
EMAIL_FROM=Wanderly <onboarding@resend.dev>
